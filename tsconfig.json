{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-3027/types/**/*.ts",
    ".next-e2e-3027/dev/types/**/*.ts",
    ".next-e2e-3028/types/**/*.ts",
    ".next-e2e-3028/dev/types/**/*.ts",
    ".next-e2e-3029/types/**/*.ts",
    ".next-e2e-3029/dev/types/**/*.ts",
    ".next-e2e-3030/types/**/*.ts",
    ".next-e2e-3030/dev/types/**/*.ts",
    ".next-e2e-3031/types/**/*.ts",
    ".next-e2e-3031/dev/types/**/*.ts",
    ".next-e2e-3040/types/**/*.ts",
    ".next-e2e-3040/dev/types/**/*.ts",
    ".next-e2e-3041/types/**/*.ts",
    ".next-e2e-3041/dev/types/**/*.ts",
    ".next-e2e-3042/types/**/*.ts",
    ".next-e2e-3042/dev/types/**/*.ts",
    ".next-e2e-3026/types/**/*.ts",
    ".next-e2e-3026/dev/types/**/*.ts",
    ".next-e2e-3073/types/**/*.ts",
    ".next-e2e-3073/dev/types/**/*.ts",
    ".next-e2e-3074/types/**/*.ts",
    ".next-e2e-3074/dev/types/**/*.ts",
    ".next-e2e-s10/types/**/*.ts",
    ".next-e2e-s10/dev/types/**/*.ts",
    ".next-e2e-s10b/types/**/*.ts",
    ".next-e2e-s10b/dev/types/**/*.ts",
    ".next-e2e-3071/types/**/*.ts",
    ".next-e2e-3071/dev/types/**/*.ts",
    ".next-e2e-3069/types/**/*.ts",
    ".next-e2e-3069/dev/types/**/*.ts",
    ".next-e2e-3070/types/**/*.ts",
    ".next-e2e-3070/dev/types/**/*.ts",
    ".next-e2e-3072/types/**/*.ts",
    ".next-e2e-3072/dev/types/**/*.ts",
    ".next-dev-diagnostic/types/**/*.ts",
    ".next-dev-diagnostic/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "assets-final",
    "BIRTHDAY_SVG_REV5",
    "font"
  ]
}
